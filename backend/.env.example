# --- Cluster connection -------------------------------------------------
# Empty ARM_KUBE_CONTEXT uses the kubeconfig current-context.
ARM_KUBE_CONTEXT=
# Empty ARM_KUBECONFIG uses $KUBECONFIG, then ~/.kube/config.
ARM_KUBECONFIG=
# Empty ARM_NAMESPACE falls back to the in-cluster service account namespace,
# then to the kubeconfig context's namespace.
ARM_NAMESPACE=

# --- Safety gates -------------------------------------------------------
# Master kill switch. While true, every mutating route returns 403.
ARM_READ_ONLY=true
# Allows actions against GUARDED workloads (platform infrastructure).
ARM_ALLOW_GUARDED_ACTIONS=false
# Allows editing ArangoDeployment tier counts (the database itself).
ARM_ALLOW_DATABASE_SCALING=false

# --- Capacity budget ----------------------------------------------------
# auto   = derive from summed requests x 1.25
# manual = use ARM_BUDGET_CPU_CORES / ARM_BUDGET_MEMORY_GI
# quota  = use a ResourceQuota if one exists
ARM_BUDGET_MODE=auto
ARM_BUDGET_CPU_CORES=
ARM_BUDGET_MEMORY_GI=

# --- Tuning -------------------------------------------------------------
ARM_INVENTORY_TTL_SECONDS=5
ARM_METRICS_TTL_SECONDS=15
ARM_PROMETHEUS_URL=
ARM_COST_PER_CORE_HOUR=0.0
ARM_COST_PER_GI_HOUR=0.0
